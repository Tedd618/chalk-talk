# ── large data — never commit ────────────────────────────────────────────────

# raw video files
videos/*.mp4
videos/*.webm
videos/*.mkv

# per-video metadata (regenerated by download.py)
videos/*.meta.json
videos/*.info.json

# extracted frames (regenerated by frames.py)
frames/

# pipeline outputs — all data lives on the shared filesystem, not git
output/

# ── queue runtime state — shared filesystem only, not git ────────────────────
queue/pending/
queue/running/
queue/done/
queue/failed/

# ── credentials — never commit ───────────────────────────────────────────────
yt-cookies.txt
