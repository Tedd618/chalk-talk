# macOS
.DS_Store
._*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Editors / IDEs
.vscode/
.idea/
*.swp

# Part A — large data and intermediate artifacts (regenerable)
part-a/experiments/*/videos/*.mp4
part-a/experiments/*/videos/*.webm
part-a/experiments/*/videos/*.info.json
part-a/experiments/*/frames/
part-a/experiments/*/output/*.mp4
part-a/experiments/*/output/*.webm
part-a/experiments/*/output/*.png

# Keep extracted stroke data, events, and per-video metadata in git (small, useful)
!part-a/experiments/*/videos/*.meta.json
!part-a/experiments/*/output/*.jsonl

# Local model checkpoints (will get big later)
*.ckpt
*.pt
*.bin

# Per-experiment checkpoint dirs but keep training logs
part-a/experiments/*/checkpoints/*.pt
part-a/experiments/*/checkpoints/*.ckpt

# Per-experiment downloaded raw data (regenerable from download script)
part-a/experiments/*/data/*.npz
part-a/experiments/*/data/*.tgz
part-a/experiments/*/data/mathwriting-2024/

# Logs
*.log
logs/
