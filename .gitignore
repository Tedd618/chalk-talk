# macOS
.DS_Store
._*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Editors / IDEs
.vscode/
.idea/
*.swp

# research — large data and intermediate artifacts (regenerable)
research/experiments/*/videos/*.mp4
research/experiments/*/videos/*.webm
research/experiments/*/videos/*.info.json
research/experiments/*/frames/
research/experiments/*/output/*.mp4
research/experiments/*/output/*.webm
research/experiments/*/output/*.png

# Keep extracted stroke data, events, and per-video metadata in git (small, useful)
!research/experiments/*/videos/*.meta.json
!research/experiments/*/output/*.jsonl

# Local model checkpoints (will get big later)
*.ckpt
*.pt
*.bin

# Per-experiment checkpoint dirs but keep training logs
research/experiments/*/checkpoints/*.pt
research/experiments/*/checkpoints/*.ckpt

# Per-experiment downloaded raw data (regenerable from download script)
research/experiments/*/data/*.npz
research/experiments/*/data/*.tgz
research/experiments/*/data/mathwriting-2024/

# Logs
*.log
logs/
